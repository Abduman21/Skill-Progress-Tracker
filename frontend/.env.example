# Same-origin defaults for Vercel Services and the Docker reverse proxy.
# Leave these empty in Vercel; internal bindings are not browser variables.
# Public build-time settings only. Never place secrets in VITE_* variables.
VITE_API_URL=
VITE_AUTH_URL=

# For separate native frontend/backend processes only, use:
# VITE_API_URL=http://localhost:5000/api/v1
# VITE_AUTH_URL=http://localhost:5000
