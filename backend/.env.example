# Copy to .env. Never commit .env or real credentials.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=skill-tracker
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
# Use none ONLY for cross-site HTTPS deployments; lax for local/same-site.
AUTH_COOKIE_SAME_SITE=lax
# Number of trusted reverse proxies; 0 for direct access.
TRUST_PROXY_HOPS=0
# Optional for CRUD; required for AI generation. Backend only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
# Optional email reminders (UTC 18:00); omit to disable delivery.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
